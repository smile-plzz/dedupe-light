<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <AssemblyName>DedupeLight</AssemblyName>
    <RootNamespace>DedupeLight</RootNamespace>
    <ApplicationIcon>assets/dedupelight.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>DedupeLight</Product>
    <Description>A lightweight Windows app for finding and reviewing exact duplicate files.</Description>
    <Authors>Ismail Hossain</Authors>
    <Copyright>Copyright © 2026 Ismail Hossain</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><Compile Remove="tests/**/*.cs" /></ItemGroup>
</Project>
